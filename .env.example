# OPENROUTER_API_KEY: OpenRouter API key for LLM analysis, AI text generation, morphology & Flash TTS speech synthesis.
# Configured via the Settings / Secrets panel in AI Studio.
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL: LLM used for morphology, philological explanation, and module generation.
# google/gemini-3.7-flash is a reasoning model: higher quality on morphological parsing,
# but it bills reasoning tokens (~260 tokens / $0.0005 for a three-word translation).
# Budget option with no reasoning overhead: google/gemini-3.1-flash-lite (~44x cheaper).
OPENROUTER_MODEL="google/gemini-3.7-flash"

# OPENROUTER_TTS_MODEL: Text-to-Speech model on OpenRouter for Reconstructed Attic/Erasmian speech.
# Note: this model does not appear in OpenRouter's /api/v1/models listing, so its
# availability can only be confirmed by making a real synthesis call.
OPENROUTER_TTS_MODEL="google/gemini-3.1-flash-tts-preview"

# GEMINI_API_KEY: Fallback provider, used when OpenRouter fails or is unset.
# STRONGLY RECOMMENDED. Without it there is no second path to speech or AI:
# google/gemini-2.0-flash-001 was withdrawn upstream with no notice and took
# every LLM feature down with it. This key is the insurance against a repeat.
GEMINI_API_KEY=""

# GEMINI_MODEL / GEMINI_TTS_MODEL: model ids used on the native Gemini fallback path.
# Only consulted when GEMINI_API_KEY is set. Defaults shown.
GEMINI_MODEL="gemini-3.7-flash"
GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview"

# APP_URL: The URL where this applet is hosted. Sent as the HTTP-Referer header
# on OpenRouter requests for app attribution. Defaults to http://localhost:3000.
APP_URL="http://localhost:3000"
