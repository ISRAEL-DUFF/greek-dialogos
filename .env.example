# OPENROUTER_API_KEY: OpenRouter API key for LLM analysis, AI text generation, morphology & Flash TTS speech synthesis.
# Configured via the Settings / Secrets panel in AI Studio.
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL: Default LLM model for OpenRouter (e.g. google/gemini-2.0-flash-001, google/gemini-2.5-flash, anthropic/claude-3.5-sonnet, openai/gpt-4o)
OPENROUTER_MODEL="google/gemini-2.0-flash-001"

# OPENROUTER_TTS_MODEL: Text-to-Speech model on OpenRouter for Reconstructed Attic/Erasmian speech
OPENROUTER_TTS_MODEL="google/gemini-3.1-flash-tts-preview"

# GEMINI_API_KEY: Optional direct Gemini AI API key fallback
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

